includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        -
            message: '#^Trait App\\Concerns\\ProfileValidationRules is used zero times and is not analysed\.$#'
            identifier: trait.unused
            path: app/Concerns/ProfileValidationRules.php
